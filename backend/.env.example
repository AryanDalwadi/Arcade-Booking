PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=arcade_booking
DB_SSL=false

# Set false to start server even if DB is unreachable (health check only)
DB_REQUIRED=true

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
