PORT=5000
NODE_ENV=development

# Local machine: ARYAN_0812 | Remote: dev-data.crmemperor.com
DB_SERVER=localhost
DB_NAME=arcade_booking

# Windows Authentication (same as SSMS Windows Auth)
DB_USE_WINDOWS_AUTH=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# SQL Authentication (set DB_USE_WINDOWS_AUTH=false to use these)
DB_PORT=1433
DB_USER=arcade_api
DB_PASSWORD=your_password

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Set false to start server even if DB is unreachable (health check only)
DB_REQUIRED=true

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
