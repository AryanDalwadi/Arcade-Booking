NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Use a long random value in deployed environments.
JWT_SECRET=local-only-change-me
JWT_ISSUER=arcade-identity
JWT_AUDIENCE=arcade-web

IDENTITY_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
ANALYTICS_SERVICE_URL=http://localhost:4007

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Use memory for one local process or redis for shared limits across replicas.
RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379

TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000
